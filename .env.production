# Build-time settings for production builds (`npm run build`), read by Next.js and inlined into the
# static files. Committed on purpose so Cloudflare Workers Builds picks them up.
# Every value here is public by design (it ends up in the browser bundle anyway).
# NEVER put secrets here: no Supabase service_role key, no Turnstile secret key.
#
# Variables set in the build environment (Cloudflare "Build variables", GitHub Actions env)
# take precedence over this file.
# An empty value counts as "not set".

# Supabase (Dashboard > Project Settings > API keys). Leave empty to keep the localStorage-only mode.
# The publishable (anon) key is meant for browsers; access is controlled by RLS in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://pixojwccqbimrzmpxocw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kOekhogBlFNsJtSG0qqnLQ_fPl4ISk1

# Cloudflare Turnstile site key (public). Empty = Cloudflare's always-pass test key (1x00000000000000000000AA).
# The matching secret key belongs in Supabase > Authentication > Attack Protection, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFy-L_HB2EdE3d23

# Public URL of the production site (absolute base for og:image / twitter:image / og:url).
NEXT_PUBLIC_SITE_URL=https://dopyu.toheritu22.workers.dev
