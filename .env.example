# Copy this file to .env: cp .env.example .env

# SQLite file (the path is relative to the project root).
# For PostgreSQL, see README: postgresql://user:pass@localhost:5432/dopyu
DATABASE_URL="file:./prisma/dev.db"

# Secret key for signing session JWTs. Required in production (32+ characters recommended).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Time zone that sets the ranking's yearly period (Jan 1 to Dec 31).
APP_TIME_ZONE="Asia/Tokyo"
