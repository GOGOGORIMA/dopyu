# Copy to .env.local for local development (.env.production holds the committed production values).

# Optional: Supabase (shared accounts, records and rankings). Leave empty to use localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (empty = Cloudflare's always-pass test key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: public URL of the site (OGP image URLs and X share posts)
NEXT_PUBLIC_SITE_URL=
